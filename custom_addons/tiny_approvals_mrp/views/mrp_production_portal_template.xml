<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_production_detail_approvals"
              inherit_id="tiny_mrp.portal_production_detail"
              name="Portal Production Detail - Stock Approval">

        <!-- Thêm nút Phê duyệt mua hàng (yêu cầu mua bổ sung hàng) sau nút Xác nhận kho -->
        <xpath expr="//button[@value='confirm_stock']/parent::form/parent::t" position="after">
            <!-- Hiện cả khi kho chưa xác nhận: NVL có thể đã hết nên cần phê duyệt trước khi xác nhận kho -->
            <t t-if="user_is_mrp_stock and not production.is_mrp_pattern and production.state_stock in ('draft', 'confirmed')">
                <!-- Nút mở modal (luôn hiển thị, cho phép tạo nhiều lần) -->
                <div class="mb-2">
                    <button type="button" class="btn btn-primary w-100"
                            data-bs-toggle="modal" data-bs-target="#stockApprovalModal">
                        <i class="fa fa-thumbs-up me-1"/> Phê duyệt mua hàng
                    </button>
                </div>

                <t t-call="tiny_approvals_mrp.stock_approval_modal">
                    <t t-set="approval_form_action" t-value="'/my/productions/%s/action' % production.id"/>
                    <t t-set="approval_modal_title">Yêu cầu phê duyệt mua hàng</t>
                    <input type="hidden" name="action" value="request_stock_approval"/>
                </t>
            </t>
        </xpath>

        <!-- Cập nhật điều kiện "Không có thao tác" để tính thêm nút mới -->
        <xpath expr="//t[@t-if][p[@class='text-muted text-center mb-0 small']]" position="replace">
            <t t-if="not (
                can_done_pattern or can_confirm_pattern or can_confirm_stock or can_confirm or
                (user_is_mrp_stock and not production.is_mrp_pattern and production.state_stock in ('draft', 'confirmed'))
            )">
                <p class="text-muted text-center mb-0 small">
                    <i class="fa fa-info-circle me-1"/>
                    Không có thao tác khả dụng.
                </p>
            </t>
        </xpath>

    </template>

</odoo>
