<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_trial_list" model="ir.ui.view">
        <field name="name">sale.trial.list</field>
        <field name="model">sale.trial</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="workcenter_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_sale_trial_form" model="ir.ui.view">
        <field name="name">sale.trial.form</field>
        <field name="model">sale.trial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workcenter_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_trial" model="ir.actions.act_window">
        <field name="name">Thử hàng</field>
        <field name="res_model">sale.trial</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_trial"
        name="Thử hàng"
        action="action_sale_trial"
        parent="sale.menu_sale_config"
        groups="sales_team.group_sale_manager"
        sequence="50"/>
</odoo>
