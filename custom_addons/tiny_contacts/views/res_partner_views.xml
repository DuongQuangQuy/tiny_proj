<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_partner_view_inherit_tiny_contacts">
        <field name="name">partner.view.inherit.tiny.contacts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="code"/>
                <field name="code_old"/>
                <field name="partner_type"/>
            </xpath>

            <xpath expr="//field[@name='website']" position="after">
                <field name="social" widget="url" placeholder="e.g. https://www.instagram.com/..."/>
                <field name="personal_contact"/>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="birthday"/>
                <field name="partner_referral_id"/>
                <field name="note_size" invisible="partner_type == 'supplier'"/>
                <field name="note_supplier" invisible="partner_type != 'supplier'"/>
            </xpath>

            <xpath expr="/form/sheet" position="before">
                <header>
                    <button name="action_set_customer"
                            type="object"
                            string="Chuyển thành khách hàng"
                            class="btn-primary"
                            invisible="partner_type != 'pre_customer'"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>