<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_tiny_sale_mrp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tiny.sale.mrp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="estimate_id" invisible="not estimate_id"/>
            </xpath>
        </field>
    </record>
</odoo>
