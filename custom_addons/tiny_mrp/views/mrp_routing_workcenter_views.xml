<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mrp_routing_workcenter_form_inherit" model="ir.ui.view">
        <field name="model">mrp.routing.workcenter</field>
        <field name="name">view.mrp.routing.workcenter.form.inherit</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="is_pattern"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_routing_workcenter_tree_inherit" model="ir.ui.view">
        <field name="model">mrp.routing.workcenter</field>
        <field name="name">view.mrp.routing.workcenter.list.inherit</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="is_pattern" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
